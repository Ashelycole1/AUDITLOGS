# Copy to .env and fill in. Never commit .env (architecture.md 12).
# Generate each secret separately, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---- Both stacks ------------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Fernet key for evidence and import files. Keep a copy apart from the backups: without it files
# cannot be read. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EVIDENCE_ENCRYPTION_KEY=

# ---- Production stack (docker-compose.yml, the server in Uganda) ------------------------------
# The public host name; the TLS certificate in deploy/certs must match it.
SERVER_NAME=
# Database owner (migrations and backups only) and the restricted role the API connects as.
DB_OWNER_PASSWORD=
APP_DB_PASSWORD=
# The client's own mail server, in Uganda (system.md 4.6). Sign-in PINs are sent through it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=
# Notifications are shown in the app. Set to true to also email them once SMTP is connected.
NOTIFY_BY_EMAIL=false
# Address of the web app, used for the link in notification emails (assignments, approvals, comments).
APP_URL=
# Downloads and exports by one person in an hour that raise a breach register alert.
DOWNLOAD_ALERT_PER_HOUR=30
# Where nightly backups go on the host, and when (Africa/Kampala). Copy this folder to a second
# location in Uganda as well (architecture.md 10).
BACKUP_DIR=/var/lib/auditlogs/backups
BACKUP_TIME=02:00

# ---- Development (docker-compose.dev.yml, or manage.py runserver without Docker) ---------------
# Local Docker database only. Never reuse a real password.
POSTGRES_PASSWORD=
# Password for the dummy accounts made by `manage.py seed_dev_users`. Empty: a random one is printed.
DEV_SEED_PASSWORD=
# Without Docker, leave empty to use a local SQLite file.
DATABASE_URL=

# ---- Optional ---------------------------------------------------------------------------------
SESSION_IDLE_MINUTES=30
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
