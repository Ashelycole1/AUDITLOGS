# Copy to .env and fill in. Never commit .env (architecture.md 12).
# ENVIRONMENT is dev or prod. In prod the app refuses to start with unsafe settings.
ENVIRONMENT=dev
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# postgres://user:password@host:5432/auditlogs. Leave empty in dev to use a local SQLite file.
# docker-compose.dev.yml builds its own from POSTGRES_PASSWORD.
DATABASE_URL=
# Local Docker database only. Generate one; never reuse a real password.
POSTGRES_PASSWORD=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Sessions and lockout
SESSION_IDLE_MINUTES=30
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# Evidence storage (used from the evidence task onwards)
EVIDENCE_ENCRYPTION_KEY=
EVIDENCE_DIR=/var/lib/auditlogs/evidence

# The client's own mail server, in Uganda (system.md 4.6)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=

BACKUP_DIR=/var/lib/auditlogs/backups

# Development only: password for the dummy accounts made by `manage.py seed_dev_users`.
# Leave empty to get a random one printed once.
DEV_SEED_PASSWORD=
